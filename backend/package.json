{
  "name": "xedien-backend",
  "version": "0.0.1",
  "description": "CMS & API backend cho website Xe Điện Xanh (sản phẩm, danh mục, trang, tin tức, liên hệ, yêu cầu tư vấn)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli",
    "db:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "db:gen": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "db:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "db:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "db:create": "npm run typeorm -- migration:create",
    "db:seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "content:export": "ts-node -r tsconfig-paths/register src/scripts/export-content.ts",
    "layout:export": "ts-node -r tsconfig-paths/register src/scripts/layout-sync/layout-export.ts",
    "layout:import": "ts-node -r tsconfig-paths/register src/scripts/layout-sync/layout-import.ts",
    "db:run:prod": "node -r dotenv/config ./node_modules/typeorm/cli migration:run -d dist/database/data-source.js",
    "db:seed:prod": "node -r dotenv/config dist/seed.js",
    "db:drop": "npm run typeorm -- schema:drop -d src/database/data-source.ts",
    "db:fresh": "npm run db:drop && npm run db:run && npm run db:seed"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "mssql": "^12.2.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "glob": "^11.0.0",
    "lodash.set": "^4.3.2",
    "path-to-regexp": "^8.3.1",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.4",
    "webpack": "^5.97.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

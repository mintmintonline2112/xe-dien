# ================= DATABASE =================
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_NAME=xedien

# ================= SERVER =================
PORT=3018
NODE_ENV=development

# ================= CORS =================
# Danh sách origin được phép, cách nhau bằng dấu phẩy
FRONTEND_URL=http://localhost:3008,http://127.0.0.1:3008

# ================= JWT =================
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=7d

# ================= MAIL (tùy chọn) =================
# Điền đủ MAIL_HOST/MAIL_USER/MAIL_PASS để bật gửi mail
# (thông báo liên hệ & yêu cầu tư vấn gửi về MAIL_FROM)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=yourmail@gmail.com
# MAIL_PASS=your_app_password
# MAIL_FROM=lienhe@xedienxanh.vn

# ================= NHẬP SẢN PHẨM TỪ WEBSITE (tùy chọn) =================
# Thư mục công cụ catalog-importer mà trang Admin → Nhập từ website chạy (mặc định ../catalog-importer)
# CATALOG_IMPORTER_DIR=/www/wwwroot/tramxedien.vn/catalog-importer

# ================= STOREFRONT REVALIDATE (tùy chọn) =================
# Backend ping sang frontend Next.js để drop cache ngay khi admin sửa nội dung
# (không đặt thì site tự làm mới sau ~60 giây). Trên VPS: http://127.0.0.1:3008
# STOREFRONT_URL=http://localhost:3008
# REVALIDATE_SECRET=change_me
